# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set the Authorization callback URL to: http://localhost:3001/auth/callback (or your production URL)

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
OAUTH_CALLBACK_URL=http://localhost:3001/auth/callback

# Alternatively, you can use a GitHub Personal Access Token directly
# COPILOT_GITHUB_TOKEN=gho_your_token_here
